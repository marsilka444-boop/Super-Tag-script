local rayParams = RaycastParams.new(); rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function hasLineOfSight(from, to) return workspace:Raycast(from, to - from, rayParams) == nil end
local function groundOk(from, to)
    local flat = (to - from) * Vector3.new(1, 0, 1); local dist = flat.Magnitude
    if dist < 1 then return true end
    local dir = flat.Unit
    for d = 3, dist, 3 do
        if not workspace:Raycast(from + dir * d + Vector3.new(0, 2, 0), Vector3.new(0, -12, 0), rayParams) then return false end
    end
    return true
end
local function computePath(hrp, goal)
    local path = PathfindingService:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, AgentCanClimb = true, WaypointSpacing = 4})
    local ok = pcall(function() path:ComputeAsync(hrp.Position, goal) end)
    if ok and path.Status == Enum.PathStatus.Success then return path:GetWaypoints() end
end

local FLEE_ANGLES = { 0, 25, -25, 50, -50, 80, -80, 110, -110, 150, -150 }
local function pickFleePoint(myHrp, tHrp)
    local away = (myHrp.Position - tHrp.Position) * Vector3.new(1, 0, 1)
    if away.Magnitude < 0.1 then away = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) end
    away = away.Unit
    local best, bestScore = nil, nil
    for _, ang in ipairs(FLEE_ANGLES) do
        local dir = CFrame.Angles(0, math.rad(ang), 0) * away
        local hit = workspace:Raycast(myHrp.Position, dir * 45, rayParams)
        local free = hit and (hit.Position - myHrp.Position).Magnitude or 45
        if free > 6 then
            local p = myHrp.Position + dir * (free - 2)
            local g = workspace:Raycast(p + Vector3.new(0, 3, 0), Vector3.new(0, -30, 0), rayParams)
            if g and g.Normal.Y > 0.6 then
                local score = ((g.Position - tHrp.Position) * Vector3.new(1, 0, 1)).Magnitude + free * 0.5 - math.abs(ang) * 0.15
                if not bestScore or score > bestScore then best, bestScore = g.Position, score end
            end
        end
    end
    return best
end

