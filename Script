                    local isThreat = (myRole == "Runner" and getRole(plr) == "Tagger") or (myRole == "Safe" and getRole(plr) == "Holder")
                    if plr ~= LocalPlayer and isThreat then
                        local _, tHrp = getChar(plr)
if tHrp then
                            local d = (tHrp.Position - myHrp.Position).Magnitude
                            if d < minDist then minDist = d; closestThreat = tHrp end
                        end
                    end
                end
                if myHum and myHrp and closestThreat and minDist < DANGER_DISTANCE then
                    rayParams.FilterDescendantsInstances = {myChar, closestThreat.Parent}
                    local fleePoint = pickFleePoint(myHrp, closestThreat)
                    if fleePoint then
                        if hasLineOfSight(myHrp.Position, fleePoint + Vector3.new(0,3,0)) and groundOk(myHrp.Position, fleePoint) then
                            myHum:MoveTo(fleePoint)
                        else
                            local waypoints = computePath(myHrp, fleePoint)
                            if waypoints then
                                for i = 2, #waypoints do
                                    if not isAutoEvade then break end
                                    if waypoints[i].Action == Enum.PathWaypointAction.Jump then myHum.Jump = true end
                                    myHum:MoveTo(waypoints[i].Position)
                                    local t0 = os.clock()
                                    while os.clock() - t0 < 1 do
                                        task.wait(0.05)
                                        if (closestThreat.Position - myHrp.Position).Magnitude < 15 then break end
                                        if ((waypoints[i].Position - myHrp.Position) * Vector3.new(1,0,1)).Magnitude < 3 then break end
                                    end
                                end
                            else myHum:MoveTo(fleePoint) end
                        end
                    else myHum.Jump = true end
                end
            end
            task.wait(0.1)
        end
    end)
end

